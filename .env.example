OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-6-luna
# Retries on rate limits / provider errors (default 10; the agent shows each wait to the user
# and logs the provider's response), and optional pacing for rate-limited accounts (e.g. 18)
# LLM_MAX_RETRIES=10
# LLM_REQUESTS_PER_MINUTE=18
AGENT_MODEL_NAME=travel-agent
DATABASE_URL=postgresql://travel:travel@localhost:5433/travel_agent
# When to save a checkpoint: exit (once per turn, default) | async | sync (after every graph step)
# CHECKPOINT_DURABILITY=exit

# LangSmith tracing (https://smith.langchain.com → Settings → API keys). Off unless true.
# Evals are not traced unless LANGSMITH_TRACE_EVALS=true (saves the free plan's 5k traces/month).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=travel-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # EU accounts: https://eu.api.smith.langchain.com
# LANGSMITH_TRACE_EVALS=false

# Open WebUI's schema in our database, and how often chats deleted there are deleted here (s)
# OPENWEBUI_SCHEMA=open_webui
# CHAT_DELETION_SYNC_SECONDS=10

# Memory consolidation (M5): review saved facts once a user's chats are idle
# MEMORY_CONSOLIDATION=true
# CONSOLIDATION_IDLE_MINUTES=10
# CONSOLIDATION_USERS_PER_CYCLE=2

# Agent progress while streaming: reasoning (collapsible block above the answer) | inline | off
# PROGRESS_STYLE=reasoning
# Show tool calls (calls) or plain-language phrases (plain)
# PROGRESS_LABELS=calls

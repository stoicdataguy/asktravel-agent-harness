OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
AGENT_MODEL_NAME=travel-agent
DATABASE_URL=postgresql://travel:travel@localhost:5433/travel_agent

# Langfuse tracing (self-hosted by docker compose; UI http://localhost:3001,
# login admin@travel.local / travel-agent-dev). Keys default to the bootstrapped dev project.
LANGFUSE_TRACING=true

# Optional: LangSmith tracing as well (free account at https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=travel-agent

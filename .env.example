OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-6-luna
# Retries on rate limits / provider errors (default 10), and optional pacing for rate-limited
# accounts (OpenRouter new accounts: 20 req/min, so e.g. 18)
# LLM_MAX_RETRIES=10
# LLM_REQUESTS_PER_MINUTE=18
AGENT_MODEL_NAME=travel-agent
DATABASE_URL=postgresql://travel:travel@localhost:5433/travel_agent

# Langfuse tracing (self-hosted by docker compose; UI http://localhost:3001,
# login admin@travel.local / travel-agent-dev). Keys default to the bootstrapped dev project.
LANGFUSE_TRACING=true

# Open WebUI's schema in our database, and how often chats deleted there are deleted here (s)
# OPENWEBUI_SCHEMA=open_webui
# CHAT_DELETION_SYNC_SECONDS=10

# Memory consolidation (M5): review saved facts once a user's chats are idle
# MEMORY_CONSOLIDATION=true
# CONSOLIDATION_IDLE_MINUTES=10
# CONSOLIDATION_USERS_PER_CYCLE=2

# Agent progress while streaming: reasoning (collapsible block above the answer) | inline | off
# PROGRESS_STYLE=reasoning
# Show tool calls (calls) or plain-language phrases (plain)
# PROGRESS_LABELS=calls
